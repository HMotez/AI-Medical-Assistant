# Backend
SECRET_KEY=your-super-secret-jwt-key-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_medical_db

# ML Service
ML_MODEL_PATH=ml/models/saved/model.joblib

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Environment
ENVIRONMENT=development
DEBUG=true

# AI Chat Assistant + free-text symptom reading (optional)
# Get your key at: https://console.anthropic.com
# Leave empty to use the offline rule-based fallbacks
ANTHROPIC_API_KEY=
# Claude model and reasoning effort for chat (low = fastest and cheapest)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_CHAT_EFFORT=low
CLAUDE_TIMEOUT_SECONDS=60
